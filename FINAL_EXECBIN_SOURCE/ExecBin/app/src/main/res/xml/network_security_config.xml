<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext (HTTP) traffic — HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Certificate pinning for Firebase/Google endpoints -->
    <!-- Pins Google Trust Services root CAs (GTS Root R1 + R2 + R3 + R4) -->
    <!-- These are long-lived root CAs valid until 2036, with backup pins -->
    <domain-config>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebaseauth.googleapis.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">fcm.googleapis.com</domain>
        <domain includeSubdomains="true">identitytoolkit.googleapis.com</domain>
        <domain includeSubdomains="true">securetoken.googleapis.com</domain>
        <pin-set expiration="2027-06-01">
            <!-- GTS Root R1 (SHA-256) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GTS Root R2 (SHA-256) -->
            <pin digest="SHA-256">Vfd95BwDeSQo+NUYxVEEIBvvpOKKV40Ylq9XoWuY7GQ=</pin>
            <!-- GlobalSign Root CA (backup) -->
            <pin digest="SHA-256">iie1VXtL7HzAMF+/PVPR9xzT80kQxdZeJ+zduCB3uj0=</pin>
            <!-- GTS Root R3 (backup) -->
            <pin digest="SHA-256">QXnt2YHvdHR3tJYmQIr0Paosp6t/nggsEGD4QJZ3Q0g=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
